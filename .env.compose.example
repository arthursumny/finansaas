APP_PORT=8096
VITE_API_URL=/api

# URL pública da aplicação (usada na geração dos links de recuperação de senha e confirmação de email)
APP_PUBLIC_URL=http://localhost:8096

# Configurações de envio de email (Resend)
# Sem RESEND_API_KEY e EMAIL_FROM, o envio de email fica desativado
# e o link de recuperação só aparece no log do container.
RESEND_API_KEY=
EMAIL_FROM=
